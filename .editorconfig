root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,html}]
indent_size = 2

# Patches nie anfassen: Leerzeichen am Zeilenende und das Dateiende gehoeren zum Diff
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = false
