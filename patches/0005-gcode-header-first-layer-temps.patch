From: orca-kobra <orca-kobra@users.noreply.github.com>
Date: Tue, 6 Oct 2026 02:16:51 +0200
Subject: [PATCH] G-code header: first layer temperatures of the filaments
 actually printed

The compatibility lines "; first_layer_bed_temperature" and
"; first_layer_temperature" were always written for filament 1. Firmwares
read them: Anycubic's GoKlipper heats the bed with the bed value for its flow
calibration and stores it for power-loss recovery, so a plate printed with
filament 4 (ASA, 110 C) used filament 1's 75 C. The bed line now follows
bed_temperature_formula like the bed temperature written before the start
G-code (highest of the used filaments, or the first printing filament), the
nozzle line uses the first printing filament.
---
 src/libslic3r/GCode.cpp        | 28 ++++++++++++++++-----
 src/libslic3r/GCode.hpp        |  2 ++
 tests/fff_print/test_gcode.cpp | 45 ++++++++++++++++++++++++++++++++++
 3 files changed, 69 insertions(+), 6 deletions(-)

diff --git a/src/libslic3r/GCode.cpp b/src/libslic3r/GCode.cpp
index b79a38632..e69ae004e 100644
--- a/src/libslic3r/GCode.cpp
+++ b/src/libslic3r/GCode.cpp
@@ -4149,12 +4149,13 @@ void GCode::_do_export(Print& print, GCodeOutputStream &file, ThumbnailsGenerato
                 file.write(full_config);
 
             // SoftFever: write compatiple image
-            int first_layer_bed_temperature = get_bed_temperature(0, true, print.config().curr_bed_type);
+            // Firmwares read these lines (e.g. Anycubic GoKlipper heats the bed with it for its flow calibration and
+            // keeps it for power-loss recovery), so write what the print actually uses instead of filament 1.
             file.write_format("; first_layer_bed_temperature = %d\n",
-                                first_layer_bed_temperature);
+                                compat_first_layer_bed_temperature(print, initial_extruder_id));
             file.write_format(
                 "; first_layer_temperature = %d\n",
-                print.config().nozzle_temperature_initial_layer.get_at(0));
+                compat_first_layer_temperature(print, initial_extruder_id));
             file.write("; CONFIG_BLOCK_END\n\n");
         } else if (thumbnail_cb != nullptr) {
             // generate the thumbnails
@@ -4737,10 +4738,10 @@ void GCode::_do_export(Print& print, GCodeOutputStream &file, ThumbnailsGenerato
           file.write(full_config);
 
         // SoftFever: write compatiple info
-        int first_layer_bed_temperature = get_bed_temperature(0, true, print.config().curr_bed_type);
-        file.write_format("; first_layer_bed_temperature = %d\n", first_layer_bed_temperature);
+        // Firmwares read these lines, so write what the print actually uses instead of filament 1 (see above).
+        file.write_format("; first_layer_bed_temperature = %d\n", compat_first_layer_bed_temperature(print, initial_extruder_id));
         file.write_format("; bed_shape = %s\n", print.full_print_config().opt_serialize("printable_area").c_str());
-        file.write_format("; first_layer_temperature = %d\n", print.config().nozzle_temperature_initial_layer.get_at(0));
+        file.write_format("; first_layer_temperature = %d\n", compat_first_layer_temperature(print, initial_extruder_id));
         file.write_format("; first_layer_height = %.3f\n", print.config().initial_layer_print_height.value);
 
           //SF TODO
@@ -5350,6 +5351,21 @@ int GCode::get_bed_temperature(const int extruder_id, const bool is_first_layer,
     return bed_temp_opt->get_at(extruder_id);
 }
 
+// First layer bed temperature as the print uses it: the same choice as the bed temperature written before the
+// start G-code (highest of the used filaments, or the first printing filament).
+int GCode::compat_first_layer_bed_temperature(const Print& print, unsigned int initial_extruder_id) const
+{
+    if (m_config.bed_temperature_formula.value == BedTempFormula::btfHighestTemp)
+        return get_highest_bed_temperature(true, print);
+    return get_bed_temperature(initial_extruder_id, true, print.config().curr_bed_type);
+}
+
+// First layer nozzle temperature of the first printing filament.
+int GCode::compat_first_layer_temperature(const Print& print, unsigned int initial_extruder_id) const
+{
+    return print.config().nozzle_temperature_initial_layer.get_at(get_filament_config_index((int) initial_extruder_id));
+}
+
 int GCode::get_highest_bed_temperature(const bool is_first_layer, const Print& print) const
 {
     auto bed_type = m_config.curr_bed_type;
diff --git a/src/libslic3r/GCode.hpp b/src/libslic3r/GCode.hpp
index c89b646ae..007d3b227 100644
--- a/src/libslic3r/GCode.hpp
+++ b/src/libslic3r/GCode.hpp
@@ -931,6 +931,8 @@ protected:
     // BBS
     int get_bed_temperature(const int extruder_id, const bool is_first_layer, const BedType bed_type) const;
     int get_highest_bed_temperature(const bool is_first_layer,const Print &print) const;
+    int compat_first_layer_bed_temperature(const Print &print, unsigned int initial_extruder_id) const;
+    int compat_first_layer_temperature(const Print &print, unsigned int initial_extruder_id) const;
 
     void update_layer_related_config(int layer_id);
 
diff --git a/tests/fff_print/test_gcode.cpp b/tests/fff_print/test_gcode.cpp
index 7bd36481d..d2268efab 100644
--- a/tests/fff_print/test_gcode.cpp
+++ b/tests/fff_print/test_gcode.cpp
@@ -12,6 +12,7 @@
 
 #include "libslic3r/TriangleMesh.hpp"
 #include "libslic3r/Point.hpp"
+#include <cstddef>
 #include <string>
 #include <vector>
 
@@ -41,3 +42,47 @@ TEST_CASE("Klipper object labels name each copy without the characters Klipper c
         CHECK(gcode.find("EXCLUDE_OBJECT_START NAME=" + instance_label + "\n") != std::string::npos);
     }
 }
+
+// Firmwares read the compatibility header lines (Anycubic's GoKlipper heats the bed with
+// first_layer_bed_temperature), so they must describe the filament the plate prints, not filament 1.
+TEST_CASE("The G-code header names the first layer temperatures of the filament the plate prints", "[GCode]")
+{
+    const std::string formula = GENERATE("by_first_filament", "by_highest_temp");
+    DYNAMIC_SECTION("bed_temperature_formula " << formula) {
+        // Filament 1: bed 60, nozzle 200. Filament 2: bed 100, nozzle 250. Everything prints with filament 2.
+        DynamicPrintConfig config = Test::multifilament_config(2, {
+            {"bed_temperature_formula", formula},
+            // Authored 1..n as PresetBundle writes it; the all-1s default collapses every per-filament value
+            // to filament 1.
+            {"filament_self_index", "1,2"},
+            {"filament_extruder_variant", "Direct Drive Standard;Direct Drive Standard"},
+            {"enable_prime_tower", 0},
+            {"nozzle_temperature_initial_layer", "200,250"},
+            {"nozzle_temperature", "200,250"},
+            {"supertack_plate_temp_initial_layer", "60,100"},
+            {"cool_plate_temp_initial_layer", "60,100"},
+            {"textured_cool_plate_temp_initial_layer", "60,100"},
+            {"eng_plate_temp_initial_layer", "60,100"},
+            {"hot_plate_temp_initial_layer", "60,100"},
+            {"textured_plate_temp_initial_layer", "60,100"},
+            {"sparse_infill_filament_id", 2},
+            {"internal_solid_filament_id", 2},
+            {"top_surface_filament_id", 2},
+            {"bottom_surface_filament_id", 2},
+            {"outer_wall_filament_id", 2},
+            {"inner_wall_filament_id", 2},
+            {"skirt_loops", 0},
+            {"brim_type", "no_brim"},
+        });
+        const std::string gcode = Test::slice({Test::cube(20)}, config);
+
+        const auto header_value = [&gcode](const std::string& key) {
+            const std::string token = "; " + key + " = ";
+            const size_t pos = gcode.find(token);
+            REQUIRE(pos != std::string::npos);
+            return std::stoi(gcode.substr(pos + token.size()));
+        };
+        CHECK(header_value("first_layer_bed_temperature") == 100);
+        CHECK(header_value("first_layer_temperature") == 250);
+    }
+}
